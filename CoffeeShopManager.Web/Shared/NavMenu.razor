<div class="sidebar-time">
    <div style="padding: 1rem; text-align: left; border-top: 1px solid rgba(255, 255, 255, 0.1); color: rgba(255, 255, 255, 0.8); font-size: 0.9rem; line-height: 1.8;">
        <div style="font-weight: 600; margin-bottom: 0.5rem;">@currentHour giờ @currentMinute phút</div>
        <div>Ngày: @currentDay</div>
        <div>Tháng: @currentMonth</div>
        <div>Năm: @currentYear</div>
    </div>
</div>

@implements IDisposable

@code {
    private int currentHour = DateTime.Now.Hour;
    private int currentMinute = DateTime.Now.Minute;
    private int currentDay = DateTime.Now.Day;
    private int currentMonth = DateTime.Now.Month;
    private int currentYear = DateTime.Now.Year;
    private System.Threading.Timer? timer;

    protected override void OnInitialized()
    {
        UpdateTime();
        timer = new System.Threading.Timer(_ =>
        {
            UpdateTime();
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
    }

    private void UpdateTime()
    {
        var now = DateTime.Now;
        currentHour = now.Hour;
        currentMinute = now.Minute;
        currentDay = now.Day;
        currentMonth = now.Month;
        currentYear = now.Year;
    }

    public void Dispose()
    {
        timer?.Dispose();
    }
}
