@page "/"
@attribute [Authorize]

<PageTitle>Trang chủ - Quản lý quán coffee</PageTitle>

<div class="text-center mb-4">
    <h1 style="font-size: 2.5rem; color: var(--coffee-dark);">☕ Coffee Shop Manager</h1>
    <p style="font-size: 1.1rem; color: #666;">Hệ thống quản lý quán coffee chuyên nghiệp</p>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-6 col-lg-3">
        <div class="card text-white bg-primary mb-3 h-100">
            <div class="card-body text-center">
                <div style="font-size: 3rem; margin-bottom: 1rem;">🪑</div>
                <h5 class="card-title" style="font-size: 1.3rem; font-weight: 600;">Quản lý bàn</h5>
                <p class="card-text" style="opacity: 0.9;">Xem và quản lý trạng thái các bàn</p>
                <a href="/ban" class="btn btn-light mt-3" style="font-weight: 600;">Đi đến →</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card text-white bg-success mb-3 h-100">
            <div class="card-body text-center">
                <div style="font-size: 3rem; margin-bottom: 1rem;">📋</div>
                <h5 class="card-title" style="font-size: 1.3rem; font-weight: 600;">Gọi món</h5>
                <p class="card-text" style="opacity: 0.9;">Tạo hóa đơn và gọi món cho khách</p>
                <a href="/goimon" class="btn btn-light mt-3" style="font-weight: 600;">Đi đến →</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card text-white bg-warning mb-3 h-100">
            <div class="card-body text-center">
                <div style="font-size: 3rem; margin-bottom: 1rem;">💳</div>
                <h5 class="card-title" style="font-size: 1.3rem; font-weight: 600;">Hóa đơn</h5>
                <p class="card-text" style="opacity: 0.9;">Quản lý và thanh toán hóa đơn</p>
                <a href="/hoadon" class="btn btn-light mt-3" style="font-weight: 600;">Đi đến →</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card text-white bg-info mb-3 h-100">
            <div class="card-body text-center">
                <div style="font-size: 3rem; margin-bottom: 1rem;">📊</div>
                <h5 class="card-title" style="font-size: 1.3rem; font-weight: 600;">Thống kê</h5>
                <p class="card-text" style="opacity: 0.9;">Xem báo cáo doanh thu</p>
                <a href="/thongke" class="btn btn-light mt-3" style="font-weight: 600;">Đi đến →</a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-6 mb-4">
        <div class="card shadow-coffee">
            <div class="card-body">
                <h3 class="text-coffee" style="font-weight: 600;">🎯 Hướng dẫn sử dụng</h3>
                <ul class="list-unstyled mt-4" style="line-height: 2.5;">
                    <li><span class="badge bg-primary">1</span> <strong>Quản lý bàn:</strong> Thêm, sửa, xóa thông tin bàn</li>
                    <li><span class="badge bg-success">2</span> <strong>Quản lý món:</strong> Thêm, sửa, xóa món trong menu</li>
                    <li><span class="badge bg-warning">3</span> <strong>Gọi món:</strong> Chọn bàn, tạo hóa đơn và thêm món</li>
                    <li><span class="badge bg-danger">4</span> <strong>Thanh toán:</strong> Xem hóa đơn và thực hiện thanh toán</li>
                    <li><span class="badge bg-info">5</span> <strong>Thống kê:</strong> Xem báo cáo doanh thu theo ngày/tháng</li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-lg-6 mb-4">
        <div class="card shadow-coffee">
            <div class="card-body">
                <h3 class="text-coffee" style="font-weight: 600;">✨ Tính năng nổi bật</h3>
                <ul class="list-unstyled mt-4" style="line-height: 2.5;">
                    <li>✅ Quản lý bàn theo thời gian thực</li>
                    <li>✅ Gọi món nhanh chóng, dễ dàng</li>
                    <li>✅ Tích điểm khách hàng thân thiết</li>
                    <li>✅ Thống kê doanh thu chi tiết</li>
                    <li>✅ Xuất báo cáo Excel/PDF</li>
                    <li>✅ Giao diện đẹp, thân thiện</li>
                </ul>
            </div>
        </div>
    </div>
</div>
