@page "/thongke"
@attribute [Authorize(Roles = "Admin,Manager")]
@inject IThongKeService ThongKeService
@inject IExportService ExportService
@inject IJSRuntime JSRuntime

<PageTitle>Dashboard doanh thu</PageTitle>
<h2>📊 Thống kê doanh thu</h2>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="card dashboard-filter-card mb-4">
    <div class="card-body">
        <div class="d-flex flex-wrap gap-2 mb-3">
            <button class="btn btn-sm @(preset == "today" ? "btn-primary" : "btn-outline-primary")" @onclick="SetToday">Hôm nay</button>
            <button class="btn btn-sm @(preset == "7days" ? "btn-primary" : "btn-outline-primary")" @onclick="SetLast7Days">7 ngày gần nhất</button>
            <button class="btn btn-sm @(preset == "month" ? "btn-primary" : "btn-outline-primary")" @onclick="SetThisMonth">Tháng này</button>
            <button class="btn btn-sm @(preset == "all" ? "btn-primary" : "btn-outline-primary")" @onclick="SetAllAsync">Tất cả</button>
            <button class="btn btn-sm @(preset == "custom" ? "btn-primary" : "btn-outline-primary")" @onclick="SetCustom">Tùy chọn</button>
        </div>
        <div class="row g-3 align-items-end">
            <div class="col-md-3"><label class="form-label">Từ ngày</label><input type="date" class="form-control" @bind="tuNgay" /></div>
            <div class="col-md-3"><label class="form-label">Đến ngày</label><input type="date" class="form-control" @bind="denNgay" /></div>
            <div class="col-md-2"><label class="form-label">Biểu đồ</label><select class="form-select" @bind="chartMode"><option value="day">Theo ngày</option><option value="month">Theo tháng</option></select></div>
            <div class="col-md-2"><button class="btn btn-primary w-100" @onclick="LoadDashboardAsync">Áp dụng</button></div>
            <div class="col-md-2"><button class="btn btn-success w-100" @onclick="ExportExcel">Xuất Excel</button></div>
        </div>
    </div>
</div>

@if (dashboard is not null)
{
    @if (dashboard.SoHoaDon == 0) { <div class="alert alert-info">Không có dữ liệu doanh thu trong khoảng thời gian này.</div> }

    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="card dashboard-kpi kpi-revenue"><div class="card-body"><span>💰 Tổng doanh thu</span><strong>@dashboard.TongDoanhThu.ToString("N0") ₫</strong></div></div></div>
        <div class="col-md-3"><div class="card dashboard-kpi kpi-invoice"><div class="card-body"><span>🧾 Hóa đơn đã thanh toán</span><strong>@dashboard.SoHoaDon</strong></div></div></div>
        <div class="col-md-3"><div class="card dashboard-kpi kpi-average"><div class="card-body"><span>📈 Trung bình/hóa đơn</span><strong>@dashboard.GiaTriTrungBinhHoaDon.ToString("N0") ₫</strong></div></div></div>
        <div class="col-md-3"><div class="card dashboard-kpi kpi-discount"><div class="card-body"><span>🎁 Tổng tiền giảm</span><strong>@((dashboard.TienGiamKhuyenMai + dashboard.TienGiamTuDiem).ToString("N0")) ₫</strong></div></div></div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card h-100">
                <div class="card-header"><strong>Doanh thu @(chartMode == "day" ? "theo ngày" : "theo tháng")</strong><span class="text-muted small float-end">Hóa đơn đã thanh toán</span></div>
                <div class="card-body">
                    @if (chartMode == "day")
                    {
                        var maxDay = dashboard.TheoNgay.Any() ? dashboard.TheoNgay.Max(x => x.TongDoanhThu) : 0;
                        foreach (var item in dashboard.TheoNgay)
                        {
                            <div class="dashboard-bar-row"><span>@item.Ngay.ToString("dd/MM")</span><div class="dashboard-bar-track"><div class="dashboard-bar" style="width:@BarWidth(item.TongDoanhThu, maxDay)%"></div></div><b>@item.TongDoanhThu.ToString("N0") ₫</b></div>
                        }
                    }
                    else
                    {
                        var maxMonth = dashboard.TheoThang.Any() ? dashboard.TheoThang.Max(x => x.TongDoanhThu) : 0;
                        foreach (var item in dashboard.TheoThang)
                        {
                            <div class="dashboard-bar-row"><span>@MonthLabel(item)</span><div class="dashboard-bar-track"><div class="dashboard-bar" style="width:@BarWidth(item.TongDoanhThu, maxMonth)%"></div></div><b>@item.TongDoanhThu.ToString("N0") ₫</b></div>
                        }
                    }
                    @if (!dashboard.TheoNgay.Any() && !dashboard.TheoThang.Any()) { <div class="text-muted text-center py-4">Chưa có dữ liệu biểu đồ.</div> }
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card h-100"><div class="card-header"><strong>Phương thức thanh toán</strong></div><div class="card-body">
                @foreach (var item in dashboard.TheoPhuongThucThanhToan)
                {
                    var percent = dashboard.TongDoanhThu == 0 ? 0 : item.DoanhThu / dashboard.TongDoanhThu * 100;
                    <div class="payment-summary"><div><span>@item.PhuongThuc</span><b>@item.DoanhThu.ToString("N0") ₫</b></div><div class="progress"><div class="progress-bar bg-coffee" style="width:@percent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div></div><small class="text-muted">@item.SoHoaDon hóa đơn (@percent.ToString("0.##")%)</small></div>
                }
                @if (!dashboard.TheoPhuongThucThanhToan.Any()) { <div class="text-muted">Chưa có dữ liệu.</div> }
            </div></div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7"><div class="card"><div class="card-header"><strong>Top món bán chạy</strong></div><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>#</th><th>Tên món</th><th>Số lượng</th><th>Doanh thu</th></tr></thead><tbody>@{ var stt = 1; } @foreach (var item in dashboard.MonBanChay) { <tr><td>@stt</td><td>@item.TenMon</td><td>@item.SoLuongBan</td><td class="text-success fw-bold">@item.DoanhThu.ToString("N0") ₫</td></tr> stt++; }</tbody></table></div></div></div>
        <div class="col-lg-5"><div class="card"><div class="card-header"><strong>Chi tiết giảm giá</strong></div><div class="card-body"><div class="d-flex justify-content-between border-bottom py-2"><span>Khuyến mãi</span><b>@dashboard.TienGiamKhuyenMai.ToString("N0") ₫</b></div><div class="d-flex justify-content-between py-2"><span>Điểm tích lũy</span><b>@dashboard.TienGiamTuDiem.ToString("N0") ₫</b></div></div></div></div>
    </div>
}

@code {
    private DashboardDoanhThuDto? dashboard;
    private DateTime tuNgay = DateTime.Today.AddDays(-6);
    private DateTime denNgay = DateTime.Today;
    private string chartMode = "day";
    private string preset = "7days";
    private string errorMessage = string.Empty;

    protected override Task OnInitializedAsync() => LoadDashboardAsync();

    private async Task LoadDashboardAsync()
    {
        errorMessage = string.Empty;
        if (denNgay.Date < tuNgay.Date) { errorMessage = "Ngày kết thúc không được trước ngày bắt đầu."; return; }
        try
        {
            var from = preset == "all" ? DateTime.MinValue : tuNgay.Date;
            dashboard = await ThongKeService.GetDashboardAsync(from, denNgay.Date.AddDays(1).AddTicks(-1));
        }
        catch (Exception ex) { errorMessage = $"Lỗi khi tải Dashboard: {ex.Message}"; }
    }

    private void SetToday() { preset = "today"; tuNgay = denNgay = DateTime.Today; }
    private void SetLast7Days() { preset = "7days"; denNgay = DateTime.Today; tuNgay = DateTime.Today.AddDays(-6); }
    private void SetThisMonth() { preset = "month"; tuNgay = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1); denNgay = DateTime.Today; }
    private async Task SetAllAsync() { preset = "all"; tuNgay = new DateTime(2000, 1, 1); denNgay = DateTime.Today; await LoadDashboardAsync(); }
    private void SetCustom() => preset = "custom";
    private static decimal BarWidth(decimal value, decimal max) => max <= 0 ? 0 : Math.Max(3, Math.Round(value / max * 100, 2));
    private static string MonthLabel(DoanhThuTheoThangDto item) => $"{item.Thang:00}/{item.Nam}";

    private async Task ExportExcel()
    {
        if (dashboard is null || !dashboard.TheoNgay.Any()) await LoadDashboardAsync();
        if (dashboard is null || !dashboard.TheoNgay.Any()) { errorMessage = "Không có dữ liệu trong khoảng thời gian này."; return; }
        var data = await ExportService.ExportDoanhThuToExcelAsync(dashboard.TheoNgay, $"BÁO CÁO DOANH THU TỪ {tuNgay:dd/MM/yyyy} ĐẾN {denNgay:dd/MM/yyyy}");
        await JSRuntime.InvokeVoidAsync("downloadFile", $"DoanhThu_{tuNgay:yyyyMMdd}_{denNgay:yyyyMMdd}.xlsx", Convert.ToBase64String(data), "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }
}
