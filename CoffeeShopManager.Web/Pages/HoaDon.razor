@page "/hoadon"
@attribute [Authorize(Roles = "Admin,Manager,Staff")]
@inject IHoaDonService HoaDonService
@inject IKhachHangService KhachHangService
@inject IKhuyenMaiService KhuyenMaiService
@inject IExportService ExportService
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory HttpClientFactory
@inject IConfiguration Configuration

<PageTitle>Danh sách hóa đơn</PageTitle>


@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>❌ Lỗi!</strong> @errorMessage
        <button type="button" class="btn-close" @onclick="@(() => errorMessage = string.Empty)"></button>
    </div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong><i class="bi bi-check-circle-fill"></i> Thành công!</strong> @successMessage
        <button type="button" class="btn-close" @onclick="@(() => successMessage = string.Empty)"></button>
    </div>
}


@* Bộ lọc ngày *@
<div class="card mb-3" style="border: 1px solid #ebdccb; border-radius: 10px; background: #faf6f0;">
    <div class="card-body py-3">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-bold small" style="color: #4a2c11;"><i class="bi bi-calendar-event me-1"></i>Từ ngày:</label>
                <input type="date" class="form-control form-control-sm" @bind="tuNgay" style="border-color: #d9c8b6;" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold small" style="color: #4a2c11;"><i class="bi bi-calendar-check me-1"></i>Đến ngày:</label>
                <input type="date" class="form-control form-control-sm" @bind="denNgay" style="border-color: #d9c8b6;" />
            </div>
            <div class="col-md-4">
                <button class="btn btn-sm text-white w-100" style="background: #733910; font-weight: 700; padding: 0.45rem 1rem;" @onclick="LoadHoaDonsByDateRange">
                    <i class="bi bi-funnel-fill me-1"></i> Lọc hóa đơn
                </button>
            </div>
        </div>
    </div>
</div>

@* Tab Navigation *@
<ul class="nav nav-pills mb-3 gap-2">
    <li class="nav-item">
        <button class="nav-link py-1 px-3 @(activeTab == "all" ? "active" : "")"
                style="@(activeTab == "all" ? "background:#733910; color:#fff;" : "background:#fff; color:#634731; border:1px solid #ccbba8;") border-radius:20px; font-weight:600; font-size:0.85rem;"
                @onclick='() => SetActiveTab("all")'>
            Tất cả (@(hoaDons?.Count ?? 0))
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link py-1 px-3 @(activeTab == "paid" ? "active" : "")"
                style="@(activeTab == "paid" ? "background:#733910; color:#fff;" : "background:#fff; color:#634731; border:1px solid #ccbba8;") border-radius:20px; font-weight:600; font-size:0.85rem;"
                @onclick='() => SetActiveTab("paid")'>
            Đã thanh toán (@(hoaDons?.Count(h => h.TrangThai == "Đã thanh toán") ?? 0))
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link py-1 px-3 @(activeTab == "unpaid" ? "active" : "")"
                style="@(activeTab == "unpaid" ? "background:#733910; color:#fff;" : "background:#fff; color:#634731; border:1px solid #ccbba8;") border-radius:20px; font-weight:600; font-size:0.85rem;"
                @onclick='() => SetActiveTab("unpaid")'>
            Chưa thanh toán (@(hoaDons?.Count(h => h.TrangThai == "Chưa thanh toán") ?? 0))
        </button>
    </li>
</ul>

@if (hoaDons == null)
{
    <div class="text-center p-4">
        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        <span class="ms-2 text-muted">Đang tải danh sách hóa đơn...</span>
    </div>
}
else
{
    <div class="card shadow-sm border-0 mb-4" style="border-radius: 10px; overflow: hidden; border: 1px solid #e8ddd4 !important;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
                <thead style="background: #733910; color: #fff;">
                    <tr>
                        <th style="padding: 0.75rem 0.6rem; width: 85px;">Mã HD</th>
                        <th style="padding: 0.75rem 0.6rem;">Bàn</th>
                        <th style="padding: 0.75rem 0.6rem;">Thời gian</th>
                        <th style="padding: 0.75rem 0.6rem; text-align: right;">Tổng tiền</th>
                        <th style="padding: 0.75rem 0.6rem; text-align: center;">Trạng thái</th>
                        <th style="padding: 0.75rem 0.6rem; text-align: center;">Phương thức</th>
                        <th style="padding: 0.75rem 0.6rem;">Khách hàng</th>
                        <th style="padding: 0.75rem 0.6rem;">Nhân viên</th>
                        <th style="padding: 0.75rem 0.6rem; text-align: center; width: 220px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (filteredHoaDons.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox" style="font-size: 2rem; color: #cbbaa9;"></i>
                                <p class="mb-0 mt-2">Không tìm thấy hóa đơn nào trong khoảng thời gian này.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var hd in filteredHoaDons)
                        {
                            <tr>
                                <td>
                                    <span class="badge" style="background:#f4ede4; color:#733910; border:1px solid #d9c8b6; font-size:0.82rem;">
                                        #@hd.MaHD
                                    </span>
                                </td>
                                <td><strong>@hd.TenBan</strong></td>
                                <td style="color:#666;">@hd.ThoiGianTao.ToString("HH:mm dd/MM/yyyy")</td>
                                <td style="text-align: right;"><strong style="color: #9c2e10; font-size: 0.95rem;">@hd.TongTien.ToString("N0") ₫</strong></td>
                                <td style="text-align: center;">
                                    <span class="badge @GetStatusClass(hd.TrangThai)" style="font-size:0.75rem; padding: 0.35rem 0.6rem; border-radius: 20px;">
                                        @hd.TrangThai
                                    </span>
                                </td>
                                <td style="text-align: center;">
                                    @if (!string.IsNullOrEmpty(hd.PhuongThucThanhToan))
                                    {
                                        var paymentIcon = hd.PhuongThucThanhToan switch
                                        {
                                            "Qua ngân hàng" => "🏦",
                                            "Thanh toán bằng điểm" => "⭐",
                                            _ => "💵"
                                        };
                                        <span class="badge" style="background: #eef2f5; color: #3b4b59; border: 1px solid #ccd6de; font-size: 0.76rem; border-radius: 20px;">
                                            @paymentIcon @hd.PhuongThucThanhToan
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@(hd.TenKH ?? "-")</td>
                                <td>@(hd.TenNV ?? "-")</td>
                                <td style="text-align: center;">
                                    <div class="btn-group" role="group">
                                        @if (hd.TrangThai == "Chưa thanh toán")
                                        {
                                            <button class="btn btn-sm btn-success" @onclick='() => ShowPaymentMethodModal(hd)'>
                                                <i class="bi bi-credit-card-fill me-1"></i> Thanh toán
                                            </button>
                                        }
                                        @if (hd.TrangThai == "Đã thanh toán")
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" @onclick='() => ShowInvoicePreviewAsync(hd.MaHD)' title="Xem chi tiết hóa đơn">
                                                <i class="bi bi-eye"></i> Xem
                                            </button>
                                            <button class="btn btn-sm text-white" style="background:#733910;" @onclick='() => PrintInvoiceAsync(hd.MaHD)' title="In hóa đơn">
                                                <i class="bi bi-printer"></i> In
                                            </button>
                                            <button class="btn btn-sm text-white" style="background:#a93226;" @onclick='() => ExportToPdf(hd.MaHD)' title="Lưu PDF">
                                                <i class="bi bi-file-earmark-pdf"></i> PDF
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* Card Thống Kê Doanh Thu *@
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card p-3" style="border: 1px solid #ebdccb; border-radius: 10px; background: #faf6f0;">
                <div class="d-flex align-items-center gap-3">
                    <div style="width: 48px; height: 48px; border-radius: 10px; background: #733910; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">
                        <i class="bi bi-receipt"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-bold">Tổng số hóa đơn lọc</div>
                        <h4 class="mb-0 fw-bold" style="color: #4a2c11;">@filteredHoaDons.Count</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card p-3" style="border: 1px solid #ebdccb; border-radius: 10px; background: #faf6f0;">
                <div class="d-flex align-items-center gap-3">
                    <div style="width: 48px; height: 48px; border-radius: 10px; background: #2e7d32; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-bold">Tổng doanh thu (Đã thanh toán)</div>
                        <h4 class="mb-0 fw-bold text-success">@filteredHoaDons.Where(h => h.TrangThai == "Đã thanh toán").Sum(h => h.TongTien).ToString("N0") ₫</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* Modal chọn phương thức thanh toán *@
@if (showPaymentModal && selectedHoaDon != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); z-index: 1060;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-coffee text-white">
                    <h5 class="modal-title"><i class="bi bi-credit-card-2-front-fill"></i> Chọn phương thức thanh toán</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="ClosePaymentModal"></button>
                </div>
                <div class="modal-body text-center">
                    @{
                        var tienGiamKhuyenMai = promotionPreview?.SoTienGiam ?? 0m;
                        var tongTienSauKhuyenMai = Math.Max(0, selectedHoaDon.TongTien - tienGiamKhuyenMai);
                    }
                    <h5 class="mb-2">Hóa đơn #@selectedHoaDon.MaHD - Tổng tiền: <span class="text-success">@selectedHoaDon.TongTien.ToString("N0") ₫</span></h5>
                    @if (promotionPreview != null)
                    {
                        <p class="mb-4 text-success"><i class="bi bi-tag-fill"></i> Giảm khuyến mãi: <strong>-@tienGiamKhuyenMai.ToString("N0") ₫</strong> | Sau khuyến mãi: <strong>@tongTienSauKhuyenMai.ToString("N0") ₫</strong></p>
                    }
                    
                    @* Thông tin khách hàng *@
                    <div class="mb-4" style="text-align: left;">
                        <h6 class="mb-3"><i class="bi bi-person-lines-fill"></i> Thông tin khách hàng (tùy chọn)</h6>
                        <div class="row g-2 mb-2">
                            <div class="col-md-6">
                                <label class="form-label">Số điện thoại:</label>
                                <input type="text" class="form-control" value="@customerPhone" 
                                       placeholder="Nhập số điện thoại để tích điểm" 
                                       @oninput="async (ChangeEventArgs e) => { customerPhone = e.Value?.ToString() ?? string.Empty; await CheckCustomerByPhone(); }" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Tên khách hàng:</label>
                                <input type="text" class="form-control" @bind="customerName" 
                                       placeholder="Nhập tên để xuất hóa đơn" />
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(customerInfoMessage))
                        {
                            <div class="alert alert-info alert-sm mb-2" style="font-size: 0.85rem; padding: 0.5rem;">
                                @customerInfoMessage
                            </div>
                        }
                    </div>

                    @if (activePromotions.Any())
                    {
                        <div class="mb-4" style="text-align: left;">
                            <label class="form-label"><i class="bi bi-tag-fill"></i> Khuyến mãi</label>
                            <select class="form-select" value="@(selectedPromotionId?.ToString() ?? string.Empty)" @onchange="OnPromotionChanged">
                                <option value="">-- Không áp dụng khuyến mãi --</option>
                                @foreach (var promotion in activePromotions)
                                {
                                    <option value="@promotion.MaKM">@promotion.TenKhuyenMai (@promotion.LoaiKhuyenMai)</option>
                                }
                            </select>
                            @if (promotionPreview != null)
                            {
                                <div class="alert alert-success mt-2 mb-0">
                                    Giảm @promotionPreview.SoTienGiam.ToString("N0") ₫. Thành tiền sau giảm: @promotionPreview.TongTienSauGiam.ToString("N0") ₫.
                                </div>
                            }
                        </div>
                    }
                    
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <div class="card payment-method-card @(selectedPaymentMethod == "Tiền mặt" ? "selected" : "")" 
                                 style="cursor: pointer; border: 2px solid @(selectedPaymentMethod == "Tiền mặt" ? "var(--coffee-primary)" : "#dee2e6");"
                                 @onclick='() => selectedPaymentMethod = "Tiền mặt"'>
                                <div class="card-body">
                                    <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">💵</div>
                                    <h6>Tiền mặt</h6>
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="card payment-method-card @(selectedPaymentMethod == "Qua ngân hàng" ? "selected" : "")" 
                                 style="cursor: pointer; border: 2px solid @(selectedPaymentMethod == "Qua ngân hàng" ? "var(--coffee-primary)" : "#dee2e6");"
                                 @onclick='() => selectedPaymentMethod = "Qua ngân hàng"'>
                                <div class="card-body">
                                    <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">🏦</div>
                                    <h6>Qua ngân hàng</h6>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (selectedPaymentMethod == "Qua ngân hàng")
                    {
                        <div class="mt-4 p-3" style="background: #f8f9fa; border-radius: 8px;">
                            <p class="mb-2"><strong>Quét mã QR để thanh toán:</strong></p>
                            <img src="https://img.vietqr.io/image/vietinbank-101879989921-compact.jpg" 
                                 alt="QR Code thanh toán" 
                                 style="max-width: 250px; height: auto; border: 1px solid #dee2e6; border-radius: 8px;" />
                            <p class="mt-2 text-muted" style="font-size: 0.85rem;">
                                Ngân hàng: VietinBank<br />
                                Số tài khoản: 101879989921
                            </p>
                        </div>
                    }
                </div>
                <div class="modal-footer" style="justify-content: center;">
                    <button type="button" class="btn btn-secondary" @onclick="ClosePaymentModal">Hủy</button>
                    <button type="button" class="btn btn-success" @onclick="ConfirmPayment" disabled="@(string.IsNullOrEmpty(selectedPaymentMethod))">
                        Xác nhận thanh toán
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showInvoicePreview && invoiceForPrint != null)
{
    <div class="modal fade show d-block invoice-preview-shell" tabindex="-1" style="background: rgba(0,0,0,0.5); z-index: 1070;">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-coffee text-white">
                    <h5 class="modal-title">Xem trước hóa đơn #@invoiceForPrint.MaHD</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseInvoicePreview"></button>
                </div>
                <div class="modal-body">
                    <div id="invoice-print-area" class="invoice-print-area" style="max-width: 480px; margin: 0 auto; background: #fff; padding: 2rem 1.75rem; border: 1px solid #dfd3c3; border-radius: 8px; box-shadow: 0 4px 16px rgba(0,0,0,0.06);">
                        <div class="text-center mb-3">
                            <h4 class="mb-1 fw-bold" style="color: #4a2c11; letter-spacing: 0.05em;">☕ COFFEE SHOP MANAGER</h4>
                            <div class="small text-muted">Coffee Shop Manager &amp; Bakery</div>
                            <div class="small text-muted">Đ/c: TP. Hồ Chí Minh • Hotline: 1900 8888</div>
                            <div class="mt-2 py-1 fw-bold" style="border-top: 1px dashed #aaa; border-bottom: 1px dashed #aaa; letter-spacing: 0.08em; color: #733910;">
                                HÓA ĐƠN THANH TOÁN
                            </div>
                        </div>

                        <div class="small mb-3" style="color: #444; line-height: 1.6;">
                            <div class="d-flex justify-content-between">
                                <span>Mã hóa đơn: <strong>#@invoiceForPrint.MaHD</strong></span>
                                <span>@invoiceForPrint.ThoiGianTao.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span>Bàn phục vụ: <strong>@invoiceForPrint.TenBan</strong></span>
                                <span>Thu ngân: <strong>@(invoiceForPrint.TenNV ?? "Staff")</strong></span>
                            </div>
                            <div>Khách hàng: <strong>@(invoiceForPrint.TenKH ?? "Khách lẻ")</strong></div>
                        </div>

                        <table class="table table-sm mb-2" style="font-size: 0.85rem; border-color: #ddd;">
                            <thead style="border-top: 1px dashed #999; border-bottom: 1px dashed #999;">
                                <tr>
                                    <th>Món</th>
                                    <th class="text-center" style="width: 40px;">SL</th>
                                    <th class="text-end" style="width: 80px;">Đơn giá</th>
                                    <th class="text-end" style="width: 90px;">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in invoiceForPrint.ChiTiets)
                                {
                                    <tr>
                                        <td>@item.TenMon</td>
                                        <td class="text-center">@item.SoLuong</td>
                                        <td class="text-end">@item.DonGia.ToString("N0")</td>
                                        <td class="text-end fw-bold">@item.ThanhTien.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <div class="small pt-2" style="border-top: 1px dashed #999; line-height: 1.7;">
                            @if (invoiceForPrint.TienGiamKhuyenMai > 0 || invoiceForPrint.TienGiamTuDiem > 0)
                            {
                                <div class="d-flex justify-content-between">
                                    <span>Tổng tiền trước giảm:</span>
                                    <span>@((invoiceForPrint.TongTien + invoiceForPrint.TienGiamKhuyenMai + invoiceForPrint.TienGiamTuDiem).ToString("N0")) ₫</span>
                                </div>
                            }
                            @if (invoiceForPrint.TienGiamKhuyenMai > 0)
                            {
                                <div class="d-flex justify-content-between text-success">
                                    <span>Giảm khuyến mãi:</span>
                                    <span>-@invoiceForPrint.TienGiamKhuyenMai.ToString("N0") ₫</span>
                                </div>
                            }
                            @if (invoiceForPrint.TienGiamTuDiem > 0)
                            {
                                <div class="d-flex justify-content-between text-info">
                                    <span>Giảm từ điểm tích lũy:</span>
                                    <span>-@invoiceForPrint.TienGiamTuDiem.ToString("N0") ₫</span>
                                </div>
                            }
                            <div class="d-flex justify-content-between align-items-center mt-2 pt-1" style="border-top: 1px solid #eee;">
                                <span class="fw-bold fs-6" style="color: #4a2c11;">TỔNG THANH TOÁN:</span>
                                <span class="fw-bold fs-5" style="color: #9c2e10;">@invoiceForPrint.TongTien.ToString("N0") ₫</span>
                            </div>
                            <div class="d-flex justify-content-between text-muted mt-1">
                                <span>Phương thức:</span>
                                <strong>@(invoiceForPrint.PhuongThucThanhToan ?? "Tiền mặt")</strong>
                            </div>
                            <div class="d-flex justify-content-between text-muted">
                                <span>Trạng thái:</span>
                                <span class="badge bg-success">@invoiceForPrint.TrangThai</span>
                            </div>
                        </div>


                    </div>
                </div>
                <div class="modal-footer invoice-preview-actions">
                    <button class="btn btn-secondary" @onclick="CloseInvoicePreview">Đóng</button>
                    <button class="btn btn-primary" @onclick="PrintCurrentInvoiceAsync">In hóa đơn</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<HoaDonDto>? hoaDons;
    private List<HoaDonDto> filteredHoaDons = new();
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private DateTime tuNgay = DateTime.Today.AddDays(-7);
    private DateTime denNgay = DateTime.Today;
    private string activeTab = "all";
    private bool showPaymentModal = false;
    private HoaDonDto? selectedHoaDon = null;
    private string selectedPaymentMethod = string.Empty;
    private string customerPhone = string.Empty;
    private string customerName = string.Empty;
    private string customerInfoMessage = string.Empty;
    private List<KhuyenMaiDto> activePromotions = new();
    private int? selectedPromotionId;
    private ApDungKhuyenMaiDto? promotionPreview;
    private bool showInvoicePreview;
    private HoaDonDto? invoiceForPrint;

    protected override async Task OnInitializedAsync()
    {
        await LoadHoaDonsByDateRange();
    }

    private async Task LoadHoaDonsByDateRange()
    {
        try
        {
            // Thêm 23:59:59 vào denNgay để bao gồm toàn bộ ngày
            var denNgayFull = denNgay.Date.AddDays(1).AddSeconds(-1);
            var result = await HoaDonService.GetHoaDonsByDateRangeAsync(tuNgay, denNgayFull);
            hoaDons = result.ToList();
            ApplyFilter();
            Console.WriteLine($"Loaded {hoaDons.Count} hóa đơn từ {tuNgay} đến {denNgayFull}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi tải danh sách hóa đơn: {ex.Message}";
        }
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (hoaDons == null)
        {
            filteredHoaDons = new List<HoaDonDto>();
            return;
        }

        filteredHoaDons = activeTab switch
        {
            "paid" => hoaDons.Where(h => h.TrangThai == "Đã thanh toán").ToList(),
            "unpaid" => hoaDons.Where(h => h.TrangThai == "Chưa thanh toán").ToList(),
            _ => hoaDons.ToList()
        };
    }

    private async Task ShowPaymentMethodModal(HoaDonDto hoaDon)
    {
        selectedHoaDon = hoaDon;
        showPaymentModal = true;
        selectedPaymentMethod = "Tiền mặt"; // Mặc định
        selectedPromotionId = null;
        promotionPreview = null;
        activePromotions = (await KhuyenMaiService.GetActiveAsync()).ToList();
    }

    private void ClosePaymentModal()
    {
        showPaymentModal = false;
        selectedHoaDon = null;
        selectedPaymentMethod = string.Empty;
        customerPhone = string.Empty;
        customerName = string.Empty;
        customerInfoMessage = string.Empty;
        activePromotions = new();
        selectedPromotionId = null;
        promotionPreview = null;
    }

    private async Task OnPromotionChanged(ChangeEventArgs args)
    {
        promotionPreview = null;
        selectedPromotionId = int.TryParse(args.Value?.ToString(), out var id) ? id : null;
        if (selectedPromotionId.HasValue && selectedHoaDon != null)
        {
            try { promotionPreview = await KhuyenMaiService.CalculateDiscountAsync(selectedPromotionId.Value, selectedHoaDon.MaHD); }
            catch (Exception ex) { errorMessage = ex.Message; selectedPromotionId = null; }
        }
    }

    private async Task ShowInvoicePreviewAsync(int maHD)
    {
        try
        {
            var invoice = await HoaDonService.GetHoaDonByIdAsync(maHD);
            if (invoice == null) throw new KeyNotFoundException("Không tìm thấy hóa đơn.");
            if (invoice.TrangThai != "Đã thanh toán")
                throw new InvalidOperationException("Chỉ được xem và in hóa đơn đã thanh toán.");
            invoiceForPrint = invoice;
            showInvoicePreview = true;
        }
        catch (Exception ex) { errorMessage = $"Lỗi khi mở hóa đơn: {ex.Message}"; }
    }

    private Task PrintInvoiceAsync(int maHD) => ShowInvoicePreviewAsync(maHD);

    private async Task PrintCurrentInvoiceAsync()
    {
        if (invoiceForPrint != null)
            await JSRuntime.InvokeVoidAsync("printInvoice");
    }

    private void CloseInvoicePreview()
    {
        showInvoicePreview = false;
        invoiceForPrint = null;
    }

    private async Task CheckCustomerByPhone()
    {
        try
        {
            customerInfoMessage = string.Empty;
            
            if (string.IsNullOrWhiteSpace(customerPhone))
            {
                return;
            }

            var khachHang = await KhachHangService.GetKhachHangBySoDienThoaiAsync(customerPhone.Trim());
            
            if (khachHang != null)
            {
                customerName = khachHang.TenKH;
                customerInfoMessage = $"Tìm thấy khách hàng: {khachHang.TenKH} (Điểm tích lũy: {khachHang.DiemTichLuy})";
            }
            else
            {
                customerInfoMessage = "Khách hàng mới. Tên sẽ được tạo tự động nếu không nhập.";
            }
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            customerInfoMessage = $"Lỗi khi kiểm tra: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task ConfirmPayment()
    {
        try
        {
            if (selectedHoaDon == null || string.IsNullOrEmpty(selectedPaymentMethod)) return;

            var confirmMessage = selectedPaymentMethod == "Qua ngân hàng" 
                ? $"Xác nhận thanh toán hóa đơn #{selectedHoaDon.MaHD} qua ngân hàng với tổng tiền {selectedHoaDon.TongTien:N0} ₫?"
                : $"Xác nhận thanh toán hóa đơn #{selectedHoaDon.MaHD} bằng tiền mặt với tổng tiền {selectedHoaDon.TongTien:N0} ₫?";

            if (await JSRuntime.InvokeAsync<bool>("confirm", confirmMessage))
            {
                var thanhToanDto = new ThanhToanDto
                {
                    MaHD = selectedHoaDon.MaHD,
                    MaKM = selectedPromotionId,
                    MaKH = null, // Sẽ được xử lý trong service
                    PhuongThucThanhToan = selectedPaymentMethod,
                    SoDienThoai = string.IsNullOrWhiteSpace(customerPhone) ? null : customerPhone.Trim(),
                    TenKH = string.IsNullOrWhiteSpace(customerName) ? null : customerName.Trim()
                };

                await HoaDonService.ThanhToanAsync(thanhToanDto);
                var paymentMethodDisplay = selectedPaymentMethod == "Thanh toán bằng điểm" 
                    ? "⭐ Thanh toán bằng điểm" 
                    : selectedPaymentMethod;
                successMessage = $"Thanh toán hóa đơn #{selectedHoaDon.MaHD} thành công bằng {paymentMethodDisplay}!";
                errorMessage = string.Empty;
                showPaymentModal = false;
                selectedHoaDon = null;
                selectedPaymentMethod = string.Empty;
                customerPhone = string.Empty;
                customerName = string.Empty;
                customerInfoMessage = string.Empty;
                await LoadHoaDonsByDateRange();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi thanh toán: {ex.Message}";
            showPaymentModal = false;
        }
    }

    private async Task ExportToPdf(int maHD)
    {
        try
        {
            errorMessage = string.Empty;
            successMessage = string.Empty;
            StateHasChanged();

            // Lấy thông tin hóa đơn
            var hoaDon = await HoaDonService.GetHoaDonByIdAsync(maHD);
            if (hoaDon == null)
            {
                errorMessage = $"Không tìm thấy hóa đơn với mã {maHD}";
                StateHasChanged();
                return;
            }

            // Xuất PDF trực tiếp từ service (không cần gọi API)
            var pdfBytes = await ExportService.ExportHoaDonToPdfAsync(hoaDon);
            var base64String = Convert.ToBase64String(pdfBytes);
            var fileName = $"HoaDon_{maHD}_{DateTime.Now:yyyyMMdd_HHmmss}.pdf";
            
            await JSRuntime.InvokeVoidAsync("downloadFile", fileName, base64String, "application/pdf");
            successMessage = $"Đã xuất PDF hóa đơn #{maHD} thành công!";
            StateHasChanged();
        }
        catch (KeyNotFoundException ex)
        {
            errorMessage = $"Không tìm thấy hóa đơn: {ex.Message}";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi xuất PDF: {ex.Message}";
            StateHasChanged();
        }
    }

    private string GetStatusClass(string trangThai)
    {
        return trangThai switch
        {
            "Chưa thanh toán" => "bg-warning",
            "Đã thanh toán" => "bg-success",
            "Đã hủy" => "bg-danger",
            _ => "bg-secondary"
        };
    }
}
