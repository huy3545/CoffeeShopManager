@page "/khachhang"
@inject IKhachHangService KhachHangService
@inject IJSRuntime JSRuntime

<PageTitle>Quản lý khách hàng</PageTitle>

<h2>👤 Quản lý khách hàng</h2>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>❌ Lỗi!</strong> @errorMessage
        <button type="button" class="btn-close" @onclick="@(() => errorMessage = string.Empty)"></button>
    </div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>✅ Thành công!</strong> @successMessage
        <button type="button" class="btn-close" @onclick="@(() => successMessage = string.Empty)"></button>
    </div>
}

<button class="btn btn-primary mb-3" @onclick="ShowAddModal">
    + Thêm khách hàng mới
</button>

@if (khachHangs == null)
{
    <p><em>Đang tải...</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Mã KH</th>
                    <th>Tên khách hàng</th>
                    <th>Điểm tích lũy</th>
                    <th>Số điện thoại</th>
                    <th>Email</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var kh in khachHangs)
                {
                    <tr>
                        <td><strong>#@kh.MaKH</strong></td>
                        <td>@kh.TenKH</td>
                        <td><span class="badge bg-success">⭐ @kh.DiemTichLuy điểm</span></td>
                        <td>@(kh.SoDienThoai ?? "-")</td>
                        <td>@(kh.Email ?? "-")</td>
                        <td>
                            <button class="btn btn-sm btn-warning" @onclick="() => ShowEditModal(kh)">Sửa</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteKhachHang(kh.MaKH)">Xóa</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Modal Thêm/Sửa Khách Hàng -->
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-coffee text-white">
                    <h5 class="modal-title">@(isEditMode ? "Sửa khách hàng" : "Thêm khách hàng mới")</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Tên khách hàng <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="formTenKH" placeholder="Ví dụ: Nguyễn Văn A" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Số điện thoại</label>
                        <input type="tel" class="form-control" @bind="formSoDienThoai" placeholder="0901234567" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" @bind="formEmail" placeholder="example@gmail.com" />
                    </div>
                    @if (isEditMode)
                    {
                        <div class="mb-3">
                            <label class="form-label">Điểm tích lũy</label>
                            <input type="number" class="form-control" @bind="formDiemTichLuy" min="0" />
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Hủy</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveKhachHang">
                        @(isEditMode ? "Lưu" : "Thêm")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<KhachHangDto>? khachHangs;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    
    // Modal states
    private bool showModal = false;
    private bool isEditMode = false;
    private int? editingKHId = null;
    private string formTenKH = string.Empty;
    private int formDiemTichLuy = 0;
    private string formSoDienThoai = string.Empty;
    private string formEmail = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadKhachHangs();
    }

    private async Task LoadKhachHangs()
    {
        try
        {
            var result = await KhachHangService.GetAllKhachHangsAsync();
            khachHangs = result.ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi tải danh sách khách hàng: {ex.Message}";
        }
    }

    private void ShowAddModal()
    {
        isEditMode = false;
        editingKHId = null;
        formTenKH = string.Empty;
        formDiemTichLuy = 0;
        formSoDienThoai = string.Empty;
        formEmail = string.Empty;
        showModal = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;
    }

    private void ShowEditModal(KhachHangDto kh)
    {
        isEditMode = true;
        editingKHId = kh.MaKH;
        formTenKH = kh.TenKH;
        formDiemTichLuy = kh.DiemTichLuy;
        formSoDienThoai = kh.SoDienThoai ?? string.Empty;
        formEmail = kh.Email ?? string.Empty;
        showModal = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;
    }

    private void CloseModal()
    {
        showModal = false;
        isEditMode = false;
        editingKHId = null;
        formTenKH = string.Empty;
        formDiemTichLuy = 0;
        formSoDienThoai = string.Empty;
        formEmail = string.Empty;
    }

    private async Task SaveKhachHang()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(formTenKH))
            {
                errorMessage = "Tên khách hàng không được để trống!";
                return;
            }

            if (isEditMode && editingKHId.HasValue)
            {
                // Update
                var updateDto = new UpdateKhachHangDto
                {
                    TenKH = formTenKH,
                    DiemTichLuy = formDiemTichLuy,
                    SoDienThoai = formSoDienThoai,
                    Email = formEmail
                };
                await KhachHangService.UpdateKhachHangAsync(editingKHId.Value, updateDto);
                successMessage = $"Đã cập nhật khách hàng {formTenKH} thành công!";
            }
            else
            {
                // Create
                var createDto = new CreateKhachHangDto
                {
                    TenKH = formTenKH,
                    SoDienThoai = formSoDienThoai,
                    Email = formEmail
                };
                await KhachHangService.CreateKhachHangAsync(createDto);
                successMessage = $"Đã thêm khách hàng {formTenKH} thành công!";
            }

            CloseModal();
            await LoadKhachHangs();
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi lưu khách hàng: {ex.Message}";
        }
    }

    private async Task DeleteKhachHang(int maKH)
    {
        try
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Bạn có chắc chắn muốn xóa khách hàng này?");
            if (confirmed)
            {
                await KhachHangService.DeleteKhachHangAsync(maKH);
                successMessage = "Xóa khách hàng thành công!";
                await LoadKhachHangs();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi xóa khách hàng: {ex.Message}";
        }
    }
}

