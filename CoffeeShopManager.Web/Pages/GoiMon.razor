@page "/goimon"
@attribute [Authorize(Roles = "Admin,Manager,Staff")]
@inject IBanService BanService
@inject IMonService MonService
@inject IHoaDonService HoaDonService
@inject IKhachHangService KhachHangService
@inject IKhuyenMaiService KhuyenMaiService
@inject IJSRuntime JSRuntime

<PageTitle>Gọi món</PageTitle>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>❌ Lỗi!</strong> @errorMessage
        <button type="button" class="btn-close" @onclick="@(() => errorMessage = string.Empty)"></button>
    </div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong><i class="bi bi-check-circle-fill"></i> Thành công!</strong> @successMessage
        <button type="button" class="btn-close" @onclick="@(() => successMessage = string.Empty)"></button>
    </div>
}

@* ===== BƯỚC 1: CHỌN BÀN ===== *@
@if (selectedBan == null && !isMangVe)
{
    <div class="goimon-section-title">
        <i class="bi bi-grid-3x3-gap-fill"></i> Chọn bàn
    </div>
    @if (bans == null)
    {
        <p><em>Đang tải...</em></p>
    }
    else
    {
        <div class="goimon-table-grid">
            @* Card Mua mang về *@
            <div class="goimon-table-card goimon-table-card-takeaway" style="cursor: pointer;"
                 @onclick="async () => await SelectMangVe()">
                <div class="goimon-table-card-header"><span class="goimon-table-number">Mang về</span><span class="badge bg-info">Take away</span></div>
                <div class="goimon-table-visual"><img src='@GetTableImage("Mang về")' alt="Mang về" /></div>
                <h5>Mua mang về</h5>
            </div>
            @foreach (var ban in bans.Where(b => b.TenBan != "Mang về"))
            {
                var canSelect = ban.TrangThai == "Trống" || ban.TrangThai == "Đã đặt" || ban.TrangThai == "Đang sử dụng";
                <div class="goimon-table-card @GetTableCardStatusClass(ban.TrangThai) @(!canSelect ? "disabled" : "")"
                     @onclick="async () => { if(canSelect) await SelectBan(ban); }">
                    <div class="goimon-table-card-header"><span class="goimon-table-number">#@ban.MaBan</span><span class="badge @GetStatusClass(ban.TrangThai)">@ban.TrangThai</span></div>
                    <div class="goimon-table-visual"><img src="@GetTableImage(ban.TenBan)" alt="@ban.TenBan" /></div>
                    <h5>@ban.TenBan</h5>
                </div>
            }
        </div>
    }
}
else
{
    @* ===== BƯỚC 2: GIAO DIỆN GỌI MÓN 2 CỘT ===== *@
    <div class="goimon-workspace">

        @* ---- CỘT TRÁI: DANH SÁCH MÓN ---- *@
        <div class="goimon-menu-panel">
            <div class="goimon-menu-header">
                <span class="goimon-menu-icon">☕</span>
                <span class="goimon-menu-title">DANH SÁCH MÓN</span>
                <button class="goimon-back-btn" @onclick="CloseBanModal" title="Quay lại chọn bàn">
                    <i class="bi bi-arrow-left"></i>
                </button>
            </div>

            @* Thanh tìm kiếm + lọc loại *@
            <div class="goimon-menu-toolbar">
                <div class="goimon-search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" placeholder="Tìm kiếm món..." @bind="searchText" @bind:event="oninput" />
                </div>
                <div class="goimon-category-tabs">
                    @foreach (var cat in categories)
                    {
                        <button class="goimon-cat-btn @(selectedCategory == cat ? "active" : "")"
                                @onclick="() => selectedCategory = cat">
                            @cat
                        </button>
                    }
                </div>
            </div>

            @* Grid món *@
            @if (mons == null)
            {
                <p><em>Đang tải...</em></p>
            }
            else
            {
                var filteredMons = mons
                    .Where(m => (selectedCategory == "Tất cả" || m.Loai == selectedCategory)
                             && (string.IsNullOrWhiteSpace(searchText) || m.TenMon.Contains(searchText, StringComparison.OrdinalIgnoreCase)))
                    .ToList();

                @if (filteredMons.Count == 0)
                {
                    <div class="goimon-no-result">
                        <i class="bi bi-cup-hot" style="font-size:2rem;"></i>
                        <p>Không tìm thấy món nào</p>
                    </div>
                }
                else
                {
                    <div class="goimon-menu-grid">
                        @foreach (var mon in filteredMons)
                        {
                            var qty = cartItems.TryGetValue(mon.MaMon, out var q) ? q : 0;
                            <div class="goimon-menu-card">
                                <div class="goimon-menu-card-img">
                                    @if (!string.IsNullOrWhiteSpace(GetMenuImage(mon)))
                                    {
                                        <img src="@GetMenuImage(mon)" alt="@mon.TenMon" />
                                    }
                                    else
                                    {
                                        <div class="goimon-menu-card-img-placeholder">
                                            <i class="bi bi-cup-hot"></i>
                                        </div>
                                    }
                                </div>
                                <div class="goimon-menu-card-body">
                                    <div class="goimon-menu-card-name">
                                        <i class="bi bi-cup-hot-fill" style="color:var(--coffee-primary);font-size:.75rem;"></i>
                                        @mon.TenMon
                                    </div>
                                    <div class="goimon-menu-card-desc">@GetMonDescription(mon.TenMon)</div>
                                    <div class="goimon-menu-card-price">@mon.DonGia.ToString("N0") đ</div>
                                    <div class="goimon-qty-controls">
                                        <button class="goimon-qty-btn minus" @onclick="() => DecreaseQty(mon)" disabled="@(qty <= 0)">−</button>
                                        <span class="goimon-qty-val">@qty</span>
                                        <button class="goimon-qty-btn plus" @onclick="() => IncreaseQty(mon)">+</button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>

        @* ---- CỘT PHẢI: THÔNG TIN ĐƠN HÀNG ---- *@
        <div class="goimon-order-panel">
            <div class="goimon-order-header">
                <span class="goimon-menu-icon">📋</span>
                <span class="goimon-menu-title">THÔNG TIN ĐƠN HÀNG</span>
            </div>

            @* Ghi chú *@
            <div class="goimon-order-note-row">
                <label>Ghi chú :</label>
                <textarea class="goimon-note-input" placeholder="Nhập ghi chú ( nếu có )" @bind="orderNote" rows="3"></textarea>
            </div>

            @* Bảng chi tiết đơn *@
            @if (currentHoaDon == null)
            {
                @if (!cartItems.Any(x => x.Value > 0))
                {
                    <div class="goimon-order-empty">
                        <i class="bi bi-cart"></i>
                        <p>Chưa có món nào</p>
                        <small>@(isMangVe ? "Đơn mang về" : $"Bàn: {selectedBan?.TenBan}")</small>
                    </div>
                }
                else
                {
                    <table class="goimon-order-table">
                        <thead>
                            <tr><th>STT</th><th>Tên món</th><th>SL</th><th>Đơn giá</th><th>Thành tiền</th></tr>
                        </thead>
                        <tbody>
                            @{ int stt = 1; }
                            @foreach (var kv in cartItems.Where(x => x.Value > 0))
                            {
                                var mon = mons?.FirstOrDefault(m => m.MaMon == kv.Key);
                                if (mon == null) continue;
                                <tr>
                                    <td>@stt</td>
                                    <td>@mon.TenMon</td>
                                    <td>@kv.Value</td>
                                    <td>@mon.DonGia.ToString("N0")</td>
                                    <td>@((mon.DonGia * kv.Value).ToString("N0"))</td>
                                </tr>
                                stt++;
                            }
                        </tbody>
                    </table>
                }
            }
            else
            {
                @if (currentHoaDon.ChiTiets.Any())
                {
                    <table class="goimon-order-table">
                        <thead>
                            <tr><th>STT</th><th>Tên món</th><th>SL</th><th>Đơn giá</th><th>Thành tiền</th></tr>
                        </thead>
                        <tbody>
                            @{ int stt2 = 1; }
                            @foreach (var ct in currentHoaDon.ChiTiets)
                            {
                                var donGia = currentHoaDon.ChiTiets.Count > 0 && ct.ThanhTien > 0 && ct.SoLuong > 0
                                    ? ct.ThanhTien / ct.SoLuong : 0;
                                <tr>
                                    <td>@stt2</td>
                                    <td>@ct.TenMon</td>
                                    <td>@ct.SoLuong</td>
                                    <td>@donGia.ToString("N0")</td>
                                    <td>@ct.ThanhTien.ToString("N0")</td>
                                </tr>
                                stt2++;
                            }
                        </tbody>
                    </table>

                    @* Cart items chưa thêm vào HD *@
                    @if (cartItems.Any(x => x.Value > 0))
                    {
                        @foreach (var kv in cartItems.Where(x => x.Value > 0))
                        {
                            var mon = mons?.FirstOrDefault(m => m.MaMon == kv.Key);
                            if (mon == null) continue;
                            <div class="goimon-pending-item">
                                <span>+ @mon.TenMon x@kv.Value</span>
                                <span class="text-muted" style="font-size:.8rem;">(chờ thêm)</span>
                            </div>
                        }
                    }
                }
                else if (!cartItems.Any(x => x.Value > 0))
                {
                    <div class="goimon-order-empty">
                        <i class="bi bi-cart"></i>
                        <p>Chưa có món nào</p>
                    </div>
                }
            }

            @* Tổng tiền *@
            <div class="goimon-order-total-row">
                <span class="goimon-total-label">Tổng tiền :</span>
                <span class="goimon-total-amount">@GetCartTotal().ToString("N0") đ</span>
            </div>

            @* Action buttons *@
            <div class="goimon-order-actions">
                @if (currentHoaDon == null)
                {
                    <button class="goimon-btn-checkout" @onclick="TaoHoaDonVaThemMon"
                            disabled="@(!cartItems.Any(x => x.Value > 0))">
                        <i class="bi bi-receipt"></i> TẠO ĐƠN
                    </button>
                    <button class="goimon-btn-clear" @onclick="ClearCart">
                        <i class="bi bi-trash3"></i> XÓA
                    </button>
                }
                else
                {
                    @if (cartItems.Any(x => x.Value > 0))
                    {
                        <button class="goimon-btn-addmore" @onclick="ThemMonVaoHD">
                            <i class="bi bi-plus-circle"></i> THÊM MÓN
                        </button>
                    }
                    <button class="goimon-btn-checkout"
                            @onclick="ShowPaymentMethodModal"
                            disabled="@(currentHoaDon.ChiTiets == null || !currentHoaDon.ChiTiets.Any())">
                        <i class="bi bi-credit-card-2-front-fill"></i> THANH TOÁN
                    </button>
                    <button class="goimon-btn-clear" @onclick="XoaHoaDon">
                        <i class="bi bi-trash3"></i> XÓA
                    </button>
                }
            </div>

            @* Status bar *@
            <div class="goimon-status-bar">
                <span><i class="bi bi-calendar3"></i> Ngày: @DateTime.Now.ToString("dd/MM/yyyy")</span>
                <span><i class="bi bi-clock"></i> Giờ: @DateTime.Now.ToString("HH:mm:ss")</span>
            </div>
        </div>
    </div>
}

@* ===== MODAL XÁC NHẬN THANH TOÁN POS CHUYÊN NGHIỆP ===== *@
@if (showPaymentModal && currentHoaDon != null)
{
    var tongTienBanDau = currentHoaDon.TongTien;
    var tienGiamKhuyenMai = promotionPreview?.SoTienGiam ?? 0m;
    var tongTienSauKhuyenMai = Math.Max(0, tongTienBanDau - tienGiamKhuyenMai);
    var tienGiamTuDiem = (diemSuDung / 100m) * 10000m;
    if (tienGiamTuDiem > tongTienSauKhuyenMai) tienGiamTuDiem = tongTienSauKhuyenMai;
    var tongTienCuoi = tongTienSauKhuyenMai - tienGiamTuDiem;
    if (tongTienCuoi < 0) tongTienCuoi = 0;
    var totalQty = currentHoaDon.ChiTiets?.Sum(c => c.SoLuong) ?? 0;

    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(20,10,5,0.7); z-index: 1060; backdrop-filter: blur(2px);">
        <div class="modal-dialog modal-xl modal-dialog-centered" style="max-width: 1140px; width: 96%;">
            <div class="modal-content pos-checkout-modal-content">
                @* Modal Header *@
                <div class="modal-header text-white" style="background: #733910; border-bottom: 2px solid #5a2e0e; padding: 0.85rem 1.25rem;">
                    <h5 class="modal-title fw-bold" style="font-size: 1.15rem; letter-spacing: 0.03em;">
                        <i class="bi bi-receipt-cutoff me-2"></i> Xác nhận thanh toán đơn hàng @(selectedBan != null ? $"- {selectedBan.TenBan}" : (isMangVe ? "- Mang về" : ""))
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="ClosePaymentModal" title="Đóng"></button>
                </div>

                @* Modal Body: 2 Cột chuẩn Image 2 *@
                <div class="modal-body p-3 p-md-4">
                    <div class="pos-checkout-grid">

                        @* ----- CỘT TRÁI: DANH SÁCH SẢN PHẨM ----- *@
                        <div class="d-flex flex-column justify-content-between" style="min-height: 100%;">
                            <div>
                                <div class="pos-section-title">
                                    <span><i class="bi bi-basket2-fill me-1"></i> DANH SÁCH SẢN PHẨM</span>
                                    <span class="badge" style="background:#733910; font-size:.78rem;">@totalQty món</span>
                                </div>

                                <div class="pos-prod-table-wrap">
                                    <table class="table table-hover pos-prod-table">
                                        <thead>
                                            <tr>
                                                <th style="width: 38px; text-align: center;">STT</th>
                                                <th>Sản phẩm</th>
                                                <th style="width: 45px; text-align: center;">SL</th>
                                                <th style="width: 78px; text-align: right;">Đơn giá</th>
                                                <th style="width: 86px; text-align: right;">Thành tiền</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (currentHoaDon.ChiTiets != null)
                                            {
                                                var stt = 1;
                                                @foreach (var ct in currentHoaDon.ChiTiets)
                                                {
                                                    var donGia = ct.SoLuong > 0 ? (ct.ThanhTien / ct.SoLuong) : 0;
                                                    <tr>
                                                        <td style="text-align: center; color: #888; font-weight:600;">@stt</td>
                                                        <td>
                                                            <div style="font-weight: 700; color: #3b2314;">@ct.TenMon</div>
                                                            <div style="font-size: .7rem; color: #8a705e;">#@ct.MaMon</div>
                                                        </td>
                                                        <td style="text-align: center; font-weight: 800; color:#4a2c11;">@ct.SoLuong</td>
                                                        <td style="text-align: right; color:#5c483a;">@donGia.ToString("N0")</td>
                                                        <td style="text-align: right; font-weight: 800; color: #9c2e10;">@ct.ThanhTien.ToString("N0")</td>
                                                    </tr>
                                                    stt++;
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            @* Nút Quay lại đơn hàng *@
                            <div class="mt-3">
                                <button type="button" class="btn w-100 pos-btn-back" @onclick="ClosePaymentModal">
                                    <i class="bi bi-arrow-left me-2"></i> QUAY LẠI ĐƠN HÀNG
                                </button>
                            </div>
                        </div>

                        @* ----- CỘT PHẢI: TÍNH TIỀN, PHƯƠNG THỨC & BÀN PHÍM POS ----- *@
                        <div>
                            @* 4 Thẻ tóm tắt trên cùng *@
                            <div class="pos-summary-cards">
                                <div class="pos-card-stat">
                                    <div class="pos-card-stat-icon"><i class="bi bi-bag-check-fill"></i></div>
                                    <div class="pos-card-stat-body">
                                        <div class="pos-card-stat-label">TỔNG TIỀN HÀNG</div>
                                        <div class="pos-card-stat-val">@tongTienBanDau.ToString("N0") <small>đ</small></div>
                                    </div>
                                </div>

                                <div class="pos-card-stat">
                                    <div class="pos-card-stat-icon"><i class="bi bi-tag-fill"></i></div>
                                    <div class="pos-card-stat-body">
                                        <div class="pos-card-stat-label">GIẢM GIÁ</div>
                                        <div class="pos-card-stat-val">@((tienGiamKhuyenMai + tienGiamTuDiem).ToString("N0")) <small>đ</small></div>
                                    </div>
                                </div>

                                <div class="pos-card-stat">
                                    <div class="pos-card-stat-icon"><i class="bi bi-file-earmark-text-fill"></i></div>
                                    <div class="pos-card-stat-body">
                                        <div class="pos-card-stat-label">THUẾ</div>
                                        <div class="pos-card-stat-val">0 <small>đ</small></div>
                                    </div>
                                </div>

                                <div class="pos-card-stat pos-card-stat-total">
                                    <div class="pos-card-stat-icon"><i class="bi bi-cash-stack"></i></div>
                                    <div class="pos-card-stat-body">
                                        <div class="pos-card-stat-label">THANH TIỀN</div>
                                        <div class="pos-card-stat-val">@tongTienCuoi.ToString("N0") <small>đ</small></div>
                                    </div>
                                </div>
                            </div>

                            @* Khung thao tác: Cột thông tin tiền + Bàn phím số *@
                            <div class="pos-operation-grid">

                                @* Cột thông tin tiền & phương thức *@
                                <div>
                                    @* Khách đưa *@
                                    <div class="mb-2">
                                        <label class="pos-op-label"><i class="bi bi-cash me-1"></i> KHÁCH ĐƯA:</label>
                                        <div class="pos-cash-input-wrap">
                                            <input type="number"
                                                   class="pos-cash-input"
                                                   @bind="cashGiven"
                                                   @bind:event="oninput"
                                                   min="0"
                                                   step="1000" />
                                            <span class="pos-currency">đ</span>
                                        </div>
                                    </div>

                                    @* Tiền thừa trả lại / Thiếu *@
                                    <div class="mb-3">
                                        <label class="pos-op-label"><i class="bi bi-arrow-repeat me-1"></i> TIỀN THỪA TRẢ LẠI:</label>
                                        @if (cashGiven < tongTienCuoi)
                                        {
                                            <div class="pos-change-box pos-change-short">
                                                <span>Thiếu:</span>
                                                <strong>@((tongTienCuoi - cashGiven).ToString("N0")) đ</strong>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="pos-change-box pos-change-ok">
                                                <span>Tiền thừa:</span>
                                                <strong>@((cashGiven - tongTienCuoi).ToString("N0")) đ</strong>
                                            </div>
                                        }
                                    </div>

                                    @* Phương thức thanh toán (Source gốc của web) *@
                                    <div class="mb-3">
                                        <label class="pos-op-label"><i class="bi bi-credit-card-2-front me-1"></i> PHƯƠNG THỨC THANH TOÁN:</label>
                                        <div class="pos-paymethod-tabs">
                                            <button type="button"
                                                    class="pos-paymethod-tab @(selectedPaymentMethod == "Tiền mặt" ? "active" : "")"
                                                    @onclick='() => SetPaymentMethod("Tiền mặt", tongTienCuoi)'>
                                                <span class="pos-paymethod-icon">💵</span>
                                                <span class="pos-paymethod-text">Tiền mặt</span>
                                            </button>
                                            <button type="button"
                                                    class="pos-paymethod-tab @(selectedPaymentMethod == "Qua ngân hàng" ? "active" : "")"
                                                    @onclick='() => SetPaymentMethod("Qua ngân hàng", tongTienCuoi)'>
                                                <span class="pos-paymethod-icon">🏦</span>
                                                <span class="pos-paymethod-text">Chuyển khoản QR</span>
                                            </button>
                                            <button type="button"
                                                    class="pos-paymethod-tab @(selectedPaymentMethod == "Thanh toán bằng điểm" ? "active" : "")"
                                                    @onclick='() => SetPaymentMethod("Thanh toán bằng điểm", tongTienCuoi)'>
                                                <span class="pos-paymethod-icon">⭐</span>
                                                <span class="pos-paymethod-text">Bằng điểm</span>
                                            </button>
                                        </div>

                                        @* Chi tiết phương thức thanh toán *@
                                        @if (selectedPaymentMethod == "Qua ngân hàng")
                                        {
                                            <div class="pos-qr-box">
                                                <img src="@($"https://img.vietqr.io/image/vietinbank-101879989921-compact2.png?amount={(long)tongTienCuoi}&addInfo=Guinn+Coffee")"
                                                     alt="Mã VietQR" class="pos-qr-img" />
                                                <div class="pos-qr-details">
                                                    <div><strong>Ngân hàng:</strong> VietinBank</div>
                                                    <div><strong>STK:</strong> <code>101879989921</code></div>
                                                    <div><strong>Số tiền:</strong> <span class="text-danger fw-bold">@tongTienCuoi.ToString("N0") đ</span></div>
                                                    <small class="text-muted">Quét mã bằng app ngân hàng</small>
                                                </div>
                                            </div>
                                        }
                                        else if (selectedPaymentMethod == "Thanh toán bằng điểm")
                                        {
                                            <div class="pos-points-box">
                                                <div>⭐ <strong>Khấu trừ điểm tích lũy thành viên</strong></div>
                                                <div style="font-size:0.78rem;" class="mt-1">
                                                    @if (customerDiem > 0)
                                                    {
                                                        <span>Khách hàng có: <strong>@customerDiem điểm</strong>. Đã dùng: <strong>@diemSuDung điểm</strong> (-@tienGiamTuDiem.ToString("N0") đ)</span>
                                                    }
                                                    else
                                                    {
                                                        <span>Quy đổi: 100 điểm = 10,000 đ giảm trực tiếp</span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>

                                    @* Ghi chú đơn hàng *@
                                    <div>
                                        <label class="pos-op-label"><i class="bi bi-pencil-square me-1"></i> GHI CHÚ:</label>
                                        <input type="text" class="pos-note-input w-100"
                                               placeholder="Nhập ghi chú (nếu có)..."
                                               @bind="orderNote" />
                                    </div>
                                </div>

                                @* Cột Bàn phím số cảm ứng POS *@
                                <div>
                                    <label class="pos-op-label"><i class="bi bi-calculator me-1"></i> NHẬP SỐ TIỀN:</label>
                                    <div class="pos-keypad-grid">
                                        <button type="button" class="pos-key-btn" @onclick='() => OnKeypadPress("7", tongTienCuoi)'>7</button>
                                        <button type="button" class="pos-key-btn" @onclick='() => OnKeypadPress("8", tongTienCuoi)'>8</button>
                                        <button type="button" class="pos-key-btn" @onclick='() => OnKeypadPress("9", tongTienCuoi)'>9</button>
                                        <button type="button" class="pos-key-btn pos-key-backspace" @onclick='() => OnKeypadPress("BACKSPACE", tongTienCuoi)' title="Xóa lùi">⌫</button>

                                        <button type="button" class="pos-key-btn" @onclick='() => OnKeypadPress("4", tongTienCuoi)'>4</button>
                                        <button type="button" class="pos-key-btn" @onclick='() => OnKeypadPress("5", tongTienCuoi)'>5</button>
                                        <button type="button" class="pos-key-btn" @onclick='() => OnKeypadPress("6", tongTienCuoi)'>6</button>
                                        <button type="button" class="pos-key-btn pos-key-op" @onclick='() => OnKeypadPress("+", tongTienCuoi)' title="Cộng thêm 10,000 đ">+</button>

                                        <button type="button" class="pos-key-btn" @onclick='() => OnKeypadPress("1", tongTienCuoi)'>1</button>
                                        <button type="button" class="pos-key-btn" @onclick='() => OnKeypadPress("2", tongTienCuoi)'>2</button>
                                        <button type="button" class="pos-key-btn" @onclick='() => OnKeypadPress("3", tongTienCuoi)'>3</button>
                                        <button type="button" class="pos-key-btn pos-key-op" @onclick='() => OnKeypadPress("-", tongTienCuoi)' title="Trừ 10,000 đ">-</button>

                                        <button type="button" class="pos-key-btn" @onclick='() => OnKeypadPress("0", tongTienCuoi)'>0</button>
                                        <button type="button" class="pos-key-btn" @onclick='() => OnKeypadPress("000", tongTienCuoi)'>000</button>
                                        <button type="button" class="pos-key-btn pos-key-exact" @onclick='() => OnKeypadPress("EXACT", tongTienCuoi)' title="Khách đưa đủ tiền">Đủ tiền</button>
                                        <button type="button" class="pos-key-btn pos-key-clear" @onclick='() => OnKeypadPress("CLEAR", tongTienCuoi)' title="Xóa về 0">C</button>
                                    </div>

                                    @* Cụm nút In hóa đơn & Thanh toán F9 *@
                                    <div class="pos-bottom-actions mt-3">
                                        <button type="button" class="btn pos-btn-print" @onclick="PrintReceipt" title="In phiếu tạm tính / hóa đơn">
                                            <i class="bi bi-printer-fill me-1"></i> IN HÓA ĐƠN
                                        </button>
                                        <button type="button" class="btn pos-btn-checkout" @onclick="ConfirmPayment">
                                            <i class="bi bi-check-circle-fill me-1"></i> THANH TOÁN (F9)
                                        </button>
                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
}


@code {
    private List<BanDto>? bans;
    private List<MonDto>? mons;
    private BanDto? selectedBan;
    private HoaDonDto? currentHoaDon;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isMangVe = false;
    private bool showPaymentModal = false;
    private string selectedPaymentMethod = string.Empty;
    private string customerPhone = string.Empty;
    private string customerName = string.Empty;
    private string customerInfoMessage = string.Empty;
    private int customerDiem = 0;
    private int diemSuDung = 0;
    private string selectedPaymentMethodForRemaining = string.Empty;
    private List<KhuyenMaiDto> activePromotions = new();
    private int? selectedPromotionId;
    private ApDungKhuyenMaiDto? promotionPreview;

    // Cart (local, chưa submit vào HD)
    private Dictionary<int, int> cartItems = new();
    private string searchText = string.Empty;
    private string selectedCategory = "Tất cả";
    private string orderNote = string.Empty;
    private decimal cashGiven = 0;

    private static readonly List<string> categories = new()
    {
        "Tất cả", "Cà phê", "Trà", "Sinh tố", "Đá xay", "Nước ép", "Khác"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            var bansResult = await BanService.GetAllBansAsync();
            bans = bansResult.ToList();

            var monsResult = await MonService.GetAllMonsAsync();
            mons = monsResult.ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi tải dữ liệu: {ex.Message}";
        }
    }

    private void IncreaseQty(MonDto mon)
    {
        if (!cartItems.ContainsKey(mon.MaMon)) cartItems[mon.MaMon] = 0;
        cartItems[mon.MaMon]++;
    }

    private void DecreaseQty(MonDto mon)
    {
        if (cartItems.TryGetValue(mon.MaMon, out var q) && q > 0)
            cartItems[mon.MaMon]--;
    }

    private void ClearCart()
    {
        cartItems.Clear();
        orderNote = string.Empty;
    }

    private decimal GetCartTotal()
    {
        if (currentHoaDon != null)
        {
            var hdTotal = currentHoaDon.TongTien;
            var cartExtra = cartItems
                .Where(kv => kv.Value > 0)
                .Sum(kv => (mons?.FirstOrDefault(m => m.MaMon == kv.Key)?.DonGia ?? 0) * kv.Value);
            return hdTotal + cartExtra;
        }
        return cartItems
            .Where(kv => kv.Value > 0)
            .Sum(kv => (mons?.FirstOrDefault(m => m.MaMon == kv.Key)?.DonGia ?? 0) * kv.Value);
    }

    private async Task SelectBan(BanDto ban)
    {
        selectedBan = ban;
        isMangVe = false;
        currentHoaDon = null;
        cartItems.Clear();

        try
        {
            var hoaDons = await HoaDonService.GetHoaDonsByBanAsync(ban.MaBan);
            var hoaDonChuaThanhToan = hoaDons.FirstOrDefault(h => h.TrangThai == "Chưa thanh toán");
            if (hoaDonChuaThanhToan != null)
            {
                currentHoaDon = hoaDonChuaThanhToan;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi kiểm tra hóa đơn: {ex.Message}";
        }
    }

    private async Task SelectMangVe()
    {
        try
        {
            isMangVe = true;
            selectedBan = null;
            currentHoaDon = null;
            cartItems.Clear();
            StateHasChanged();

            var banMangVe = bans?.FirstOrDefault(b => b.TenBan == "Mang về");
            if (banMangVe != null)
            {
                var hoaDons = await HoaDonService.GetHoaDonsByBanAsync(banMangVe.MaBan);
                var hoaDonChuaThanhToan = hoaDons.FirstOrDefault(h => h.TrangThai == "Chưa thanh toán");
                if (hoaDonChuaThanhToan != null)
                {
                    currentHoaDon = hoaDonChuaThanhToan;
                    StateHasChanged();
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi chọn mua mang về: {ex.Message}";
            StateHasChanged();
        }
    }

    private void CloseBanModal()
    {
        selectedBan = null;
        isMangVe = false;
        currentHoaDon = null;
        cartItems.Clear();
        orderNote = string.Empty;
        showPaymentModal = false;
        selectedPaymentMethod = string.Empty;
    }

    /// <summary>Tạo hóa đơn mới rồi thêm tất cả cart items vào</summary>
    private async Task TaoHoaDonVaThemMon()
    {
        try
        {
            int maBan;
            if (isMangVe)
            {
                var banMangVe = bans?.FirstOrDefault(b => b.TenBan == "Mang về");
                if (banMangVe == null)
                {
                    var createBanDto = new CreateBanDto { TenBan = "Mang về", TrangThai = "Trống" };
                    banMangVe = await BanService.CreateBanAsync(createBanDto);
                    await LoadData();
                }
                maBan = banMangVe.MaBan;
            }
            else
            {
                if (selectedBan == null) return;
                maBan = selectedBan.MaBan;
            }

            var createDto = new CreateHoaDonDto { MaBan = maBan, MaNV = 1 };
            currentHoaDon = await HoaDonService.CreateHoaDonAsync(createDto);

            // Thêm từng món từ cart vào hóa đơn
            foreach (var kv in cartItems.Where(x => x.Value > 0))
            {
                var goiMonDto = new GoiMonDto
                {
                    MaHD = currentHoaDon.MaHD,
                    MaMon = kv.Key,
                    SoLuong = kv.Value
                };
                currentHoaDon = await HoaDonService.GoiMonAsync(goiMonDto);
            }

            cartItems.Clear();
            successMessage = "Tạo đơn hàng thành công!";
            await LoadData();
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi tạo đơn: {ex.Message}";
        }
    }

    /// <summary>Thêm cart items vào hóa đơn đã có</summary>
    private async Task ThemMonVaoHD()
    {
        try
        {
            if (currentHoaDon == null) return;
            foreach (var kv in cartItems.Where(x => x.Value > 0))
            {
                var goiMonDto = new GoiMonDto
                {
                    MaHD = currentHoaDon.MaHD,
                    MaMon = kv.Key,
                    SoLuong = kv.Value
                };
                currentHoaDon = await HoaDonService.GoiMonAsync(goiMonDto);
            }
            cartItems.Clear();
            successMessage = "Thêm món thành công!";
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi thêm món: {ex.Message}";
        }
    }

    private async Task XoaHoaDon()
    {
        try
        {
            if (currentHoaDon == null) return;
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Bạn có chắc muốn xóa toàn bộ đơn hàng này?");
            if (confirmed)
            {
                await HoaDonService.DeleteHoaDonAsync(currentHoaDon.MaHD);
                currentHoaDon = null;
                cartItems.Clear();
                successMessage = "Đã xóa đơn hàng.";
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi xóa đơn: {ex.Message}";
        }
    }

    private async Task ShowPaymentMethodModal()
    {
        if (currentHoaDon != null && currentHoaDon.ChiTiets != null && currentHoaDon.ChiTiets.Any())
        {
            showPaymentModal = true;
            selectedPaymentMethod = "Tiền mặt";
            cashGiven = currentHoaDon.TongTien;
            selectedPromotionId = null;
            promotionPreview = null;
            activePromotions = (await KhuyenMaiService.GetActiveAsync()).ToList();
        }
    }

    // Đổi phương thức thanh toán
    private void SetPaymentMethod(string method, decimal finalTotal)
    {
        selectedPaymentMethod = method;
        if (selectedPaymentMethod == "Qua ngân hàng")
        {
            cashGiven = finalTotal;
            diemSuDung = 0;
        }
        else if (selectedPaymentMethod == "Thanh toán bằng điểm")
        {
            if (customerDiem >= 100)
            {
                SelectPaymentByPoints();
            }
            cashGiven = finalTotal;
        }
        else
        {
            diemSuDung = 0;
            cashGiven = finalTotal;
        }
    }

    // Xử lý bấm bàn phím số cảm ứng POS
    private void OnKeypadPress(string key, decimal finalTotal)
    {
        if (key == "CLEAR")
        {
            cashGiven = 0;
        }
        else if (key == "EXACT")
        {
            cashGiven = finalTotal;
        }
        else if (key == "BACKSPACE")
        {
            var str = ((long)cashGiven).ToString();
            if (str.Length > 1)
            {
                if (decimal.TryParse(str.Substring(0, str.Length - 1), out var val))
                    cashGiven = val;
                else
                    cashGiven = 0;
            }
            else
            {
                cashGiven = 0;
            }
        }
        else if (key == "000")
        {
            cashGiven = cashGiven * 1000;
            if (cashGiven > 999999999) cashGiven = 999999999;
        }
        else if (key == "+")
        {
            cashGiven += 10000;
        }
        else if (key == "-")
        {
            if (cashGiven >= 10000) cashGiven -= 10000;
            else cashGiven = 0;
        }
        else if (int.TryParse(key, out int digit))
        {
            var current = (long)cashGiven;
            if (current == 0)
            {
                cashGiven = digit;
            }
            else
            {
                var str = current.ToString() + digit.ToString();
                if (decimal.TryParse(str, out decimal result) && result <= 999999999)
                {
                    cashGiven = result;
                }
            }
        }
    }

    // In hóa đơn / tạm tính
    private async Task PrintReceipt()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("window.print");
        }
        catch { }
    }

    private void ClosePaymentModal()
    {
        showPaymentModal = false;
        selectedPaymentMethod = string.Empty;
        customerPhone = string.Empty;
        customerName = string.Empty;
        customerInfoMessage = string.Empty;
        customerDiem = 0;
        diemSuDung = 0;
        selectedPaymentMethodForRemaining = string.Empty;
        activePromotions = new();
        selectedPromotionId = null;
        promotionPreview = null;
    }

    private async Task OnPromotionChanged(ChangeEventArgs args)
    {
        selectedPromotionId = int.TryParse(args.Value?.ToString(), out var id) ? id : null;
        promotionPreview = null;

        if (selectedPromotionId.HasValue && currentHoaDon != null)
        {
            try
            {
                promotionPreview = await KhuyenMaiService.CalculateDiscountAsync(selectedPromotionId.Value, currentHoaDon.MaHD);
            }
            catch (Exception ex)
            {
                errorMessage = ex.Message;
                selectedPromotionId = null;
            }
        }
    }

    private async Task CheckCustomerByPhone()
    {
        try
        {
            customerInfoMessage = string.Empty;
            if (string.IsNullOrWhiteSpace(customerPhone)) return;

            var khachHang = await KhachHangService.GetKhachHangBySoDienThoaiAsync(customerPhone.Trim());
            if (khachHang != null)
            {
                customerName = khachHang.TenKH;
                customerDiem = khachHang.DiemTichLuy;
                customerInfoMessage = $"Tìm thấy khách hàng: {khachHang.TenKH} (Điểm tích lũy: {khachHang.DiemTichLuy})";
            }
            else
            {
                customerDiem = 0;
                customerInfoMessage = "Khách hàng mới. Tên sẽ được tạo tự động nếu không nhập.";
            }

            diemSuDung = 0;
            selectedPaymentMethodForRemaining = string.Empty;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            customerInfoMessage = $"Lỗi khi kiểm tra: {ex.Message}";
            StateHasChanged();
        }
    }

    private void SelectPaymentByPoints()
    {
        if (customerDiem < 100 || currentHoaDon == null)
        {
            errorMessage = customerDiem < 100
                ? "Cần ít nhất 100 điểm để sử dụng tính năng thanh toán bằng điểm"
                : "Vui lòng nhập số điện thoại khách hàng để sử dụng điểm";
            return;
        }
        selectedPaymentMethod = "Thanh toán bằng điểm";
        var tongTienBanDau = currentHoaDon.TongTien;
        var diemToiDa = (int)Math.Floor((tongTienBanDau / 10000m) * 100m);
        diemSuDung = Math.Min(customerDiem, diemToiDa);
        StateHasChanged();
    }

    private async Task ConfirmPayment()
    {
        try
        {
            if (currentHoaDon == null || string.IsNullOrEmpty(selectedPaymentMethod)) return;

            if (currentHoaDon.ChiTiets == null || !currentHoaDon.ChiTiets.Any())
            {
                await HoaDonService.DeleteHoaDonAsync(currentHoaDon.MaHD);
                successMessage = "Hóa đơn đã được xóa vì không có món nào.";
                currentHoaDon = null;
                showPaymentModal = false;
                await LoadData();
                return;
            }

            var tongTienBanDau = currentHoaDon.TongTien;
            var tienGiamTuDiem = (diemSuDung / 100m) * 10000m;
            if (tienGiamTuDiem > tongTienBanDau) tienGiamTuDiem = tongTienBanDau;
            var tongTienCuoi = tongTienBanDau - tienGiamTuDiem;
            if (tongTienCuoi < 0) tongTienCuoi = 0;

            if (selectedPaymentMethod == "Thanh toán bằng điểm")
            {
                if (customerDiem < 100)
                {
                    errorMessage = "Cần ít nhất 100 điểm để sử dụng tính năng thanh toán bằng điểm";
                    return;
                }
                var diemToiDa = (int)Math.Floor((tongTienBanDau / 10000m) * 100m);
                diemSuDung = Math.Min(customerDiem, diemToiDa);
                tienGiamTuDiem = (diemSuDung / 100m) * 10000m;
                if (tienGiamTuDiem > tongTienBanDau) tienGiamTuDiem = tongTienBanDau;
                tongTienCuoi = tongTienBanDau - tienGiamTuDiem;
                if (tongTienCuoi < 0) tongTienCuoi = 0;
            }

            var phuongThucThanhToan = selectedPaymentMethod;
            if (selectedPaymentMethod == "Thanh toán bằng điểm" && !string.IsNullOrEmpty(selectedPaymentMethodForRemaining))
                phuongThucThanhToan = $"{selectedPaymentMethod} + {selectedPaymentMethodForRemaining}";

            var thanhToanDto = new ThanhToanDto
            {
                MaHD = currentHoaDon.MaHD,
                MaKH = null,
                PhuongThucThanhToan = phuongThucThanhToan,
                SoDienThoai = string.IsNullOrWhiteSpace(customerPhone) ? null : customerPhone.Trim(),
                TenKH = string.IsNullOrWhiteSpace(customerName) ? null : customerName.Trim(),
                DiemSuDung = diemSuDung,
                MaKM = selectedPromotionId
            };

            await HoaDonService.ThanhToanAsync(thanhToanDto);
            successMessage = $"✅ Thanh toán thành công Hóa đơn #{currentHoaDon.MaHD}! Tổng tiền: {tongTienCuoi:N0} ₫.";

            selectedBan = null;
            isMangVe = false;
            currentHoaDon = null;
            cartItems.Clear();
            showPaymentModal = false;
            selectedPaymentMethod = string.Empty;
            customerPhone = string.Empty;
            customerName = string.Empty;
            customerInfoMessage = string.Empty;
            customerDiem = 0;
            diemSuDung = 0;
            selectedPaymentMethodForRemaining = string.Empty;
            activePromotions = new();
            selectedPromotionId = null;
            promotionPreview = null;
            await LoadData();

        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi thanh toán: {ex.Message}";
            showPaymentModal = false;
        }
    }

