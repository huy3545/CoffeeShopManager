@page "/mon"
@attribute [Authorize(Roles = "Admin,Manager,Staff")]
@using Microsoft.AspNetCore.Components.Forms
@inject IMonService MonService
@inject IJSRuntime JSRuntime
@inject IWebHostEnvironment WebHostEnvironment
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Quản lý món</PageTitle>

<h2><i class="bi bi-cup-hot-fill"></i> Quản lý món</h2>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>❌ Lỗi!</strong> @errorMessage
        <button type="button" class="btn-close" @onclick="@(() => errorMessage = string.Empty)"></button>
    </div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong><i class="bi bi-check-circle-fill"></i> Thành công!</strong> @successMessage
        <button type="button" class="btn-close" @onclick="@(() => successMessage = string.Empty)"></button>
    </div>
}

@if (canManage)
{
    <button class="btn btn-primary mb-3" @onclick="ShowAddModal">
        + Thêm món mới
    </button>
}

@if (mons == null)
{
    <p><em>Đang tải...</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Mã món</th>
                    <th>Hình ảnh</th>
                    <th>Tên món</th>
                    <th>Đơn giá</th>
                    <th>Loại</th>
                    @if (canManage)
                    {
                        <th>Thao tác</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var mon in mons)
                {
                    <tr>
                        <td><strong>#@mon.MaMon</strong></td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(GetMenuImage(mon)))
                            {
                                <img class="menu-item-image" src="@GetMenuImage(mon)" alt="@mon.TenMon" />
                            }
                            else
                            {
                                <span class="menu-item-image-placeholder"><i class="bi bi-cup-hot"></i></span>
                            }
                        </td>
                        <td>@mon.TenMon</td>
                        <td><strong class="text-success">@mon.DonGia.ToString("N0") ₫</strong></td>
                        <td><span class="badge bg-info">@mon.Loai</span></td>
                        @if (canManage)
                        {
                            <td>
                                <button class="btn btn-sm btn-warning" @onclick="() => ShowEditModal(mon)">Sửa</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteMon(mon.MaMon)">Xóa</button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Modal Thêm/Sửa Món -->
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-coffee text-white">
                    <h5 class="modal-title">@(isEditMode ? "Sửa món" : "Thêm món mới")</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Tên món <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="formTenMon" placeholder="Ví dụ: Latte" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Đơn giá (VNĐ) <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" @bind="formDonGia" placeholder="Ví dụ: 45000" min="0" step="1000" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Loại <span class="text-danger">*</span></label>
                        <select class="form-select" @bind="formLoai">
                            <option value="Cà phê">Cà phê</option>
                            <option value="Trà">Trà</option>
                            <option value="Nước ép">Nước ép</option>
                            <option value="Đồ ăn nhẹ">Đồ ăn nhẹ</option>
                            <option value="Sinh tố">Sinh tố</option>
                            <option value="Khác">Khác</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Hình ảnh món</label>
                        <InputFile class="form-control" OnChange="OnImageSelected" accept="image/png,image/jpeg,image/webp,image/gif" />
                        <small class="text-muted">Định dạng PNG, JPG, WEBP hoặc GIF, tối đa 5 MB.</small>
                        @if (!string.IsNullOrWhiteSpace(formImageUrl))
                        {
                            <div class="menu-image-preview mt-2">
                                <img src="@formImageUrl" alt="Ảnh món hiện tại" />
                                <span>Ảnh hiện tại</span>
                            </div>
                        }
                        @if (selectedImage != null)
                        {
                            <div class="small text-success mt-2"><i class="bi bi-check-circle"></i> @selectedImage.Name</div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Hủy</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveMon">
                        @(isEditMode ? "Lưu" : "Thêm")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<MonDto>? mons;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    
    // Modal states
    private bool showModal = false;
    private bool isEditMode = false;
    private int? editingMonId = null;
    private string formTenMon = string.Empty;
    private decimal formDonGia = 0;
    private string formLoai = "Cà phê";
    private bool canManage;
    private string? formImageUrl;
    private IBrowserFile? selectedImage;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        canManage = authState.User.IsInRole("Admin") || authState.User.IsInRole("Manager");
        await LoadMons();
    }

    private async Task LoadMons()
    {
        try
        {
            var result = await MonService.GetAllMonsAsync();
            mons = result.ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi tải danh sách món: {ex.Message}";
        }
    }

    private void ShowAddModal()
    {
        isEditMode = false;
        editingMonId = null;
        formTenMon = string.Empty;
        formDonGia = 0;
        formLoai = "Cà phê";
        formImageUrl = null;
        selectedImage = null;
        showModal = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;
    }

    private void ShowEditModal(MonDto mon)
    {
        isEditMode = true;
        editingMonId = mon.MaMon;
        formTenMon = mon.TenMon;
        formDonGia = mon.DonGia;
        formLoai = mon.Loai;
        formImageUrl = GetMenuImage(mon);
        selectedImage = null;
        showModal = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;
    }

    private void CloseModal()
    {
        showModal = false;
        isEditMode = false;
        editingMonId = null;
        formTenMon = string.Empty;
        formDonGia = 0;
        formLoai = "Cà phê";
        formImageUrl = null;
        selectedImage = null;
    }

    private void OnImageSelected(InputFileChangeEventArgs args)
    {
        selectedImage = args.File;
        errorMessage = string.Empty;
    }

    private static string? GetMenuImage(MonDto mon)
    {
        if (!string.IsNullOrWhiteSpace(mon.HinhAnh))
            return mon.HinhAnh;

        return mon.TenMon.Trim().ToLowerInvariant() switch
        {
            "cà phê đen" => "images/mon/capheden.png",
            "cà phê sữa" => "images/mon/caphesua.png",
            "bạc xỉu" => "images/mon/bacxiu.png",
            "cappuccino" => "images/mon/cappuchino.png",
            "trà đào cam sả" => "images/mon/tradamcamsa.png",
            "trà sữa trân châu" => "images/mon/trasuatranchau.png",
            "nước cam ép" => "images/mon/nuoccamep.png",
            "sinh tố bơ" => "images/mon/sinhtobo.png",
            _ => null
        };
    }

    private async Task SaveMon()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(formTenMon))
            {
                errorMessage = "Tên món không được để trống!";
                return;
            }

            if (formDonGia <= 0)
            {
                errorMessage = "Đơn giá phải lớn hơn 0!";
                return;
            }

            var imageUrl = formImageUrl;
            if (selectedImage != null)
            {
                imageUrl = await SaveImageAsync(selectedImage);
            }

            if (isEditMode && editingMonId.HasValue)
            {
                // Update
                var updateDto = new UpdateMonDto
                {
                    TenMon = formTenMon,
                    DonGia = formDonGia,
                    Loai = formLoai,
                    HinhAnh = imageUrl
                };
                await MonService.UpdateMonAsync(editingMonId.Value, updateDto);
                successMessage = $"Đã cập nhật món {formTenMon} thành công!";
            }
            else
            {
                // Create
                var createDto = new CreateMonDto
                {
                    TenMon = formTenMon,
                    DonGia = formDonGia,
                    Loai = formLoai,
                    HinhAnh = imageUrl
                };
                await MonService.CreateMonAsync(createDto);
                successMessage = $"Đã thêm món {formTenMon} thành công!";
            }

            CloseModal();
            await LoadMons();
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi lưu món: {ex.Message}";
        }
    }

    private async Task<string> SaveImageAsync(IBrowserFile image)
    {
        var allowedExtensions = new[] { ".png", ".jpg", ".jpeg", ".webp", ".gif" };
        var extension = Path.GetExtension(image.Name).ToLowerInvariant();
        if (!allowedExtensions.Contains(extension))
            throw new InvalidOperationException("Ảnh phải có định dạng PNG, JPG, WEBP hoặc GIF.");

        const long maxFileSize = 5 * 1024 * 1024;
        if (image.Size > maxFileSize)
            throw new InvalidOperationException("Kích thước ảnh không được vượt quá 5 MB.");

        var imageDirectory = Path.Combine(WebHostEnvironment.WebRootPath, "images", "mon");
        Directory.CreateDirectory(imageDirectory);
        var fileName = $"mon-{Guid.NewGuid():N}{extension}";
        var filePath = Path.Combine(imageDirectory, fileName);

        await using var source = image.OpenReadStream(maxFileSize);
        await using var target = File.Create(filePath);
        await source.CopyToAsync(target);
        return $"images/mon/{fileName}";
    }

    private async Task DeleteMon(int maMon)
    {
        try
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Bạn có chắc chắn muốn xóa món này?");
            if (confirmed)
            {
                await MonService.DeleteMonAsync(maMon);
                successMessage = "Xóa món thành công!";
                await LoadMons();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi xóa món: {ex.Message}";
        }
    }
}
